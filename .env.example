# ─────────────────────────────────────────────────────────────────────────────
# server/.env.example  —  template for production env vars.
# In Coolify: set these in the project's Environment Variables panel.
# For local dev: use .env.dev.example instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com
WEB_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres superuser (used only to initialize the DB)
POSTGRES_USER=your_superuser
POSTGRES_PASSWORD=your_strong_superuser_password
POSTGRES_DB=mohajon

# Application DB user (created by docker/postgres/init/01-create-accounts.sh)
APP_DB_USER=your_app_user
APP_DB_PASSWORD=your_strong_app_password

# PgBouncer (connection pooler)
PGBOUNCER_DB_USER=your_bouncer_user
PGBOUNCER_DB_PASSWORD=your_strong_bouncer_password
PGBOUNCER_DB_NAME=mohajon
PGBOUNCER_AUTH_TYPE=scram-sha-256
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_TIMEOUT=5
PGBOUNCER_SERVER_IDLE_TIMEOUT=300

# IMPORTANT: Must be 0 when using PgBouncer in transaction pool mode.
# Non-zero values cause connection pool exhaustion and FATAL DB errors.
CONN_MAX_AGE=0
# Prod: Django connects through PgBouncer, NOT directly to Postgres
DATABASE_URL=postgres://your_bouncer_user:your_strong_bouncer_password@pgbouncer:5432/mohajon

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Celery broker uses Redis db 1 — separated from cache (db 0) to avoid key collisions
CELERY_BROKER_URL=redis://redis:6379/1

# ── Storage / Media (S3 or Cloudflare R2) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=your_s3_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_s3_or_r2_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=auto
# Leave empty for real AWS S3; set to your R2 endpoint for Cloudflare
AWS_S3_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
CDN_BASE_URL=https://cdn.yourdomain.com

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_user
EMAIL_HOST_PASSWORD=your_smtp_password

# ── AI (LLM & Embeddings) ─────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── Chat & Channels (Meta / WhatsApp) ─────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_OAUTH_REDIRECT_URI=https://app.yourdomain.com/api/callback/integrations/meta
# IMPORTANT: Change this from the default — it secures your Meta webhook endpoint.
META_WEBHOOK_VERIFY_TOKEN=replace-with-random-50-char-string

# ── Misc (Monitoring & Auth) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SENTRY_DSN=your_sentry_dsn
# Controls percentage of transactions sent to Sentry for performance monitoring (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
