# ─────────────────────────────────────────────────────────────────────────────
# server/.env.dev.example  —  copy to server/.env for local development.
# Usage: docker compose -f docker-compose.dev.yml up
#
# All values below are safe dev-only defaults. They are committed to source
# control intentionally — they contain no real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-dev-only-not-for-production
DEBUG=True
WEB_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Postgres ──────────────────────────────────────────────────────────────────
# Superuser (used only during initial DB creation)
POSTGRES_USER=mohajon_admin
POSTGRES_PASSWORD=mohajon_dev_pass
POSTGRES_DB=mohajon

# App user (created by docker/postgres/init/01-create-accounts.sh)
APP_DB_USER=mohajon
APP_DB_PASSWORD=mohajon_app_pass

# These are required by the init script even in dev (no PgBouncer actually runs)
PGBOUNCER_DB_USER=mohajon_bouncer
PGBOUNCER_DB_PASSWORD=mohajon_bouncer_pass

# ── Connection URLs ───────────────────────────────────────────────────────────
# Dev: Django connects DIRECTLY to Postgres (no PgBouncer)
DATABASE_URL=postgres://mohajon:mohajon_app_pass@db:5432/mohajon
REDIS_URL=redis://redis:6379/0
# Celery uses Redis db 1 to avoid collisions with the cache on db 0
CELERY_BROKER_URL=redis://redis:6379/1

# ── S3 / Cloudflare R2 ────────────────────────────────────────────────────────
# In dev: leave blank to skip S3 (files won't upload) OR point to a local MinIO
# instance if you need to test media uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=mohajon-dev
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
CDN_BASE_URL=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Meta / Facebook OAuth ─────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/callback/integrations/meta
META_WEBHOOK_VERIFY_TOKEN=dev-insecure-webhook-token

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
